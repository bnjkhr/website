---
interface Props {
  compact?: boolean;
  heading?: string;
}

const {
  compact = false,
  heading = "Neue Beiträge per E-Mail",
} = Astro.props;
// Optional Cloudflare Turnstile. Without the public site key no script and no widget are added.
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || "";
---

<aside class:list={["newsletter", { "newsletter--compact": compact }]} id="newsletter" aria-labelledby="newsletter-title">
  <div class="newsletter__copy">
    <h2 id="newsletter-title">{heading}</h2>
    <p>Unregelmäßige Updates zu meinen Produkten und dem, was beim Entwickeln dahinter passiert.</p>
  </div>
  <form class="newsletter__form" action="/api/newsletter-subscribe" method="post" data-newsletter-form data-turnstile-sitekey={turnstileSiteKey || undefined}>
    <div class="newsletter__field">
      <label for={`newsletter-email-${compact ? "compact" : "full"}`}>E-Mail-Adresse</label>
      <div class="newsletter__controls">
        <input
          id={`newsletter-email-${compact ? "compact" : "full"}`}
          name="email"
          type="email"
          inputmode="email"
          autocomplete="email"
          placeholder="du@beispiel.de"
          maxlength="254"
          required
        />
        <button type="submit">Updates abonnieren</button>
      </div>
    </div>
    <div class="newsletter__trap" aria-hidden="true">
      <label>Website <input name="website" type="text" tabindex="-1" autocomplete="off" /></label>
    </div>
    {turnstileSiteKey && <div data-turnstile-container></div>}
    <p class="newsletter__legal">Nach der Anmeldung erhältst du eine Bestätigungsmail. Klicks auf Links in den E-Mails werden ausgewertet. Abmeldung jederzeit. Details im <a href="/datenschutz.html">Datenschutz</a>.</p>
    <p class="newsletter__status" role="status" aria-live="polite" data-newsletter-status></p>
  </form>
</aside>

<script>
  type TurnstileApi = {
    render(container: HTMLElement, options: Record<string, unknown>): string;
    reset(widgetId: string): void;
  };

  const MIN_TOKEN_AGE_MS = 3_250; // the server requires 3 s; the margin covers clock rounding
  const MAX_TOKEN_AGE_MS = 100 * 60 * 1000; // the server accepts 2 h; renew well before that
  const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
  const turnstile = () => (window as unknown as { turnstile?: TurnstileApi }).turnstile;

  // One form token per page is enough: it is not bound to an address, so all forms share it.
  let formToken: { value: string; fetchedAt: number } | null = null;
  let pendingToken: Promise<void> | null = null;

  function refreshFormToken() {
    pendingToken ??= fetch("/api/newsletter-token", { headers: { Accept: "application/json" }, cache: "no-store" })
      .then((response) => (response.ok ? response.json() : Promise.reject(new Error("token"))))
      .then(({ token }) => { formToken = { value: token, fetchedAt: Date.now() }; })
      .catch(() => { formToken = null; })
      .finally(() => { pendingToken = null; });
    return pendingToken;
  }

  // Resolves with a token that is old enough to be accepted, waiting for it if necessary.
  async function readyFormToken() {
    if (!formToken || Date.now() - formToken.fetchedAt > MAX_TOKEN_AGE_MS) await refreshFormToken();
    if (!formToken) return "";
    await wait(formToken.fetchedAt + MIN_TOKEN_AGE_MS - Date.now());
    return formToken.value;
  }

  const forms = document.querySelectorAll<HTMLFormElement>("[data-newsletter-form]");
  if (forms.length) void refreshFormToken();

  const siteKey = forms[0]?.dataset.turnstileSitekey;
  if (siteKey) {
    const loader = document.createElement("script");
    loader.src = "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit";
    loader.async = true;
    document.head.append(loader);
  }

  forms.forEach((form) => {
    const container = form.querySelector<HTMLElement>("[data-turnstile-container]");
    let widgetId: string | undefined;
    let turnstileResponse = "";

    async function mountTurnstile() {
      while (!turnstile()) await wait(100);
      widgetId = turnstile()!.render(container!, {
        sitekey: siteKey,
        appearance: "interaction-only",
        callback: (response: string) => { turnstileResponse = response; },
        "expired-callback": () => { turnstileResponse = ""; },
      });
    }
    if (container && siteKey) void mountTurnstile();

    async function readyTurnstileResponse() {
      for (let i = 0; i < 100 && !turnstileResponse; i++) await wait(100);
      return turnstileResponse;
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const button = form.querySelector<HTMLButtonElement>("button[type='submit']");
      const status = form.querySelector<HTMLElement>("[data-newsletter-status]");
      if (!button || !status) return;

      button.disabled = true;
      status.dataset.state = "pending";
      status.textContent = "Anmeldung wird gesendet …";

      try {
        const [formTokenValue, turnstileValue] = await Promise.all([
          readyFormToken(),
          container ? readyTurnstileResponse() : "",
        ]);
        const payload: Record<string, unknown> = { ...Object.fromEntries(new FormData(form)), formToken: formTokenValue };
        if (container) payload["cf-turnstile-response"] = turnstileValue;
        const response = await fetch(form.action, {
          method: "POST",
          headers: { Accept: "application/json", "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        const result = await response.json();
        if (!response.ok) throw new Error(result.message || "Die Anmeldung konnte nicht gesendet werden.");
        form.reset();
        status.dataset.state = "success";
        status.textContent = "Fast geschafft: Bitte bestätige die Anmeldung über die E-Mail in deinem Postfach.";
      } catch (error) {
        formToken = null; // a rejected or expired token must not be reused
        void refreshFormToken();
        status.dataset.state = "error";
        status.textContent = error instanceof Error ? error.message : "Die Anmeldung konnte nicht gesendet werden.";
      } finally {
        if (widgetId) {
          turnstileResponse = ""; // Turnstile responses are single-use
          turnstile()?.reset(widgetId);
        }
        button.disabled = false;
      }
    });
  });
</script>

<style>
  .newsletter {
    display: grid;
    grid-template-columns: minmax(0, .85fr) minmax(360px, 1.15fr);
    gap: clamp(32px, 6vw, 84px);
    padding: clamp(32px, 5vw, 64px);
    border: 1px solid var(--ink);
    border-radius: var(--radius, 28px);
    background: var(--acid);
    color: var(--ink);
    box-shadow: 12px 14px 0 rgba(22, 32, 25, .1);
  }
  .newsletter--compact { box-shadow: none; }
  .newsletter h2 { font-size: var(--type-h2-small, clamp(2rem, 3.2vw, 3.2rem)); text-wrap: balance; }
  .newsletter__copy > p { max-width: 510px; margin-top: 15px; color: #455238; }
  .newsletter__field label { display: block; margin-bottom: 9px; font-size: .82rem; font-weight: 740; }
  .newsletter__controls { display: flex; gap: 9px; }
  .newsletter input {
    min-width: 0;
    min-height: 52px;
    flex: 1;
    padding: 0 16px;
    border: 1px solid var(--ink);
    border-radius: 14px;
    background: var(--paper);
    color: var(--ink);
    font: inherit;
  }
  .newsletter button {
    min-height: 52px;
    padding: 0 19px;
    border: 1px solid var(--ink);
    border-radius: 14px;
    background: var(--ink);
    color: #fff;
    font: inherit;
    font-weight: 760;
    cursor: pointer;
  }
  .newsletter button:hover { background: #2b382f; }
  .newsletter button:disabled { cursor: wait; opacity: .65; }
  .newsletter__legal, .newsletter__status { margin: 10px 0 0; font-size: .76rem; line-height: 1.5; }
  .newsletter__legal { color: #4e5d41; }
  .newsletter__legal a { font-weight: 700; }
  .newsletter__status:empty { display: none; }
  .newsletter__status[data-state="success"] { font-weight: 720; }
  .newsletter__status[data-state="error"] { color: #8c2817; font-weight: 720; }
  .newsletter__trap { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }

  @media (max-width: 820px) {
    .newsletter { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .newsletter { padding: 26px 20px; border-radius: 22px; }
    .newsletter__controls { flex-direction: column; }
    .newsletter button { width: 100%; }
  }
</style>
