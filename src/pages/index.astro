---
import { getCollection } from "astro:content";
import NewsletterForm from "../components/NewsletterForm.astro";

const [latestPost] = (await getCollection("blog", ({ data }) => !data.draft))
    .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const formatDate = (date: Date) => new Intl.DateTimeFormat("de-DE", {
    day: "2-digit",
    month: "long",
    year: "numeric",
}).format(date);
---
<!doctype html>
<html lang="de">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Ich bin Ben Kohler aus Ulm. Hier zeige ich meine Projekte FamilyManager, Track4Kids, GymBo und MAISON BENCHRIS und erzähle, was sie miteinander verbindet.">
    <meta name="theme-color" content="#eef1ea">
    <link rel="canonical" href="https://benkohler.de/">
    <link rel="alternate" type="application/rss+xml" title="Ben Kohler Blog" href="https://benkohler.de/rss.xml">
    <link rel="manifest" href="/site.webmanifest">
    <title>Ben Kohler · Meine Projekte</title>
    <style is:global>
        @font-face {
            font-family: "Inter";
            src: url("/fonts/Inter-latin.woff2") format("woff2");
            font-style: normal;
            font-weight: 100 900;
            font-display: swap;
        }

        @font-face {
            font-family: "Stack Sans Notch";
            src: url("/fonts/StackSansNotch-regular.woff2") format("woff2");
            font-style: normal;
            font-weight: 400;
            font-display: swap;
        }

        :root {
            --canvas: #eef1ea;
            --paper: #fbfcf8;
            --ink: #162019;
            --muted: #5c685f;
            --rule: #cbd2c9;
            --signal: #e85835;
            --acid: #d2ef7c;
            --family: #435fe6;
            --family-soft: #dce2ff;
            --kids: #ffe477;
            --kids-blue: #0b3b91;
            --gym: #19191d;
            --gym-purple: #a05fe7;
            --care: #ead8d1;
            --care-ink: #132736;
            --wrap: 1320px;
            --radius: 28px;
            --ease: cubic-bezier(.2, .8, .2, 1);
            --type-display: clamp(3.4rem, 6vw, 6.2rem);
            --type-h2: clamp(2.7rem, 4.6vw, 4.6rem);
            --type-h2-small: clamp(2.1rem, 3.2vw, 3.2rem);
            --gutter: clamp(26px, 3vw, 40px);
        }

        * { box-sizing: border-box; }
        html { scroll-behavior: smooth; scroll-padding-top: 92px; }
        body {
            margin: 0;
            color: var(--ink);
            background: var(--canvas);
            font-family: "Inter", -apple-system, BlinkMacSystemFont, sans-serif;
            font-size: 16px;
            line-height: 1.55;
            -webkit-font-smoothing: antialiased;
        }

        body::before {
            content: "";
            position: fixed;
            inset: 0;
            z-index: -1;
            pointer-events: none;
            opacity: .36;
            background-image: radial-gradient(rgba(22, 32, 25, .18) .55px, transparent .55px);
            background-size: 7px 7px;
        }

        img { display: block; max-width: 100%; height: auto; }
        a { color: inherit; }
        h1, h2, h3, p, figure { margin: 0; }
        h1, h2, h3 { font-family: "Stack Sans Notch", "Inter", sans-serif; font-weight: 400; line-height: .96; letter-spacing: -.035em; }

        ::selection { background: var(--acid); color: var(--ink); }
        a { text-underline-offset: .2em; }
        :focus-visible { outline: 3px solid var(--signal); outline-offset: 4px; }

        .skip {
            position: fixed;
            top: -80px;
            left: 20px;
            z-index: 100;
            padding: 12px 18px;
            background: var(--ink);
            color: #fff;
        }
        .skip:focus { top: 20px; }
        .shell { width: min(var(--wrap), calc(100% - 40px)); margin-inline: auto; }

        .nav {
            position: sticky;
            top: 0;
            z-index: 50;
            border-bottom: 1px solid rgba(22, 32, 25, .12);
            background: color-mix(in srgb, var(--canvas) 88%, transparent);
            backdrop-filter: blur(18px);
        }
        .nav__inner { min-height: 72px; display: flex; align-items: center; justify-content: space-between; gap: 28px; }
        .brand { display: inline-flex; align-items: center; gap: 12px; text-decoration: none; font-weight: 790; letter-spacing: -.025em; }
        .brand__mark { position: relative; width: 18px; height: 18px; border: 2px solid var(--ink); border-radius: 50%; }
        .brand__mark::before, .brand__mark::after { content: ""; position: absolute; width: 6px; height: 6px; border-radius: 50%; }
        .brand__mark::before { top: -4px; right: -5px; background: var(--signal); }
        .brand__mark::after { bottom: -4px; left: -5px; background: var(--acid); }
        .nav__links { display: flex; align-items: center; gap: 4px; }
        .nav__links a { min-height: 44px; display: inline-flex; align-items: center; padding: 0 13px; color: var(--muted); text-decoration: none; font-size: .9rem; font-weight: 650; }
        .nav__links a:hover { color: var(--ink); }
        .nav__links .nav__mail { margin-left: 8px; border: 1px solid var(--ink); border-radius: 999px; color: var(--ink); }

        .hero { overflow: hidden; border-bottom: 1px solid var(--rule); }
        .hero__grid {
            min-height: 760px;
            display: grid;
            grid-template-columns: minmax(0, .92fr) minmax(520px, 1.08fr);
            align-items: center;
            gap: clamp(40px, 4.5vw, 68px);
            padding-block: clamp(56px, 6vw, 88px);
        }
        .hero h1 { max-width: 770px; margin-top: 0; font-size: var(--type-display); text-wrap: balance; }
        .hero__lede { max-width: 630px; margin-top: 28px; color: var(--muted); font-size: clamp(1.08rem, 1.6vw, 1.3rem); line-height: 1.62; }
        .hero__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
        .button { min-height: 52px; display: inline-flex; align-items: center; justify-content: center; gap: 9px; padding: 0 21px; border: 1px solid var(--ink); border-radius: 999px; text-decoration: none; font-weight: 760; transition: transform .25s var(--ease), box-shadow .25s var(--ease); }
        .button:hover { transform: translateY(-3px); box-shadow: 0 8px 18px rgba(22, 32, 25, .14); }
        .button:active { transform: translateY(0); box-shadow: none; }
        .button--primary { background: var(--ink); color: #fff; }
        .button--quiet { background: rgba(251, 252, 248, .65); }

        .atlas { position: relative; display: grid; grid-template-columns: 1.08fr .92fr; grid-template-rows: 1fr 1fr; min-height: 580px; border: 1px solid var(--ink); border-radius: 36px; overflow: hidden; box-shadow: 18px 20px 0 rgba(22, 32, 25, .09); }
        .atlas__tile { display: grid; grid-template-rows: minmax(0, 1fr) auto; min-width: 0; overflow: hidden; color: var(--ink); text-decoration: none; }
        .atlas__tile:nth-child(-n+2) { border-bottom: 1px solid var(--ink); }
        .atlas__tile:nth-child(odd) { border-right: 1px solid var(--ink); }
        .atlas__tile:focus-visible { outline-offset: -5px; }
        .atlas__media { position: relative; min-height: 0; overflow: hidden; }
        .atlas__label { position: relative; display: flex; flex-wrap: wrap; align-items: baseline; gap: 3px 8px; padding: 14px 18px; background: inherit; font-size: .92rem; font-weight: 790; letter-spacing: -.02em; }
        .atlas__label small { font-size: .73rem; font-weight: 600; letter-spacing: 0; }
        .atlas__family { background: var(--family-soft); color: #182352; }
        .atlas__family img { position: absolute; width: 52%; right: 17%; top: 28px; border: 5px solid #1b255a; border-radius: 23px; box-shadow: 0 21px 34px rgba(26, 43, 113, .2); transform: rotate(-5deg); transition: transform .45s var(--ease); }
        .atlas__family:hover img { transform: rotate(-2deg) translateY(-6px); }
        .atlas__kids { background: var(--kids); color: var(--kids-blue); }
        .atlas__kids img { position: absolute; width: 62%; top: 36px; left: 19%; filter: drop-shadow(0 15px 18px rgba(11, 59, 145, .18)); }
        .atlas__gym { background: var(--gym); color: #f7f5f2; }
        .atlas__gym img { position: absolute; width: 52%; left: 22%; top: 24px; border: 5px solid #050505; border-radius: 23px; box-shadow: 0 20px 38px #0008; transform: rotate(4deg); transition: transform .45s var(--ease); }
        .atlas__gym:hover img { transform: rotate(1deg) translateY(-6px); }
        .atlas__gym .atlas__media::before { content: ""; position: absolute; width: 138px; height: 138px; right: -40px; top: -38px; border-radius: 50%; background: var(--gym-purple); }
        .atlas__care { background: var(--care); color: var(--care-ink); }
        .maison-video { display: block; width: 100%; height: 100%; object-fit: cover; }
        .atlas__care .maison-video { position: absolute; inset: 0; }

        .section { padding-block: clamp(90px, 10vw, 145px); }
        .section__head { max-width: 720px; margin-bottom: clamp(36px, 4vw, 56px); }
        .section__head h2 { font-size: var(--type-h2); text-wrap: balance; }
        .section__head p { max-width: 58ch; margin-top: 20px; color: var(--muted); font-size: 1.12rem; line-height: 1.65; }

        .worlds { display: grid; grid-template-columns: repeat(12, 1fr); gap: 18px; }
        .world { container-type: inline-size; position: relative; display: flex; flex-direction: column; min-height: 560px; overflow: hidden; border: 1px solid rgba(22, 32, 25, .22); border-radius: var(--radius); color: var(--ink); text-decoration: none; }
        .world--family, .world--care { grid-column: span 7; }
        .world--kids, .world--gym { grid-column: span 5; }
        .world__copy { position: relative; z-index: 5; flex: 0 0 auto; padding: var(--gutter) var(--gutter) 0; }
        .world__area { display: block; margin-bottom: 20px; font-size: .86rem; font-weight: 720; }
        .world h3 { font-size: clamp(1.9rem, 8.5cqi, 4.4rem); }
        .world__claim { max-width: 30ch; margin-top: 18px; font-size: 1.12rem; font-weight: 650; line-height: 1.45; }
        .world__desc { max-width: 46ch; margin-top: 10px; color: color-mix(in srgb, currentColor 78%, transparent); }
        .world__link { position: relative; z-index: 5; display: inline-flex; flex: 0 0 auto; align-self: flex-start; align-items: center; gap: 8px; margin: 22px var(--gutter) 0; padding-bottom: 4px; border-bottom: 2px solid currentColor; font-weight: 780; }
        .world__media { position: relative; z-index: 2; flex: 1 1 auto; min-height: 250px; margin-top: 24px; pointer-events: none; }
        .world__visual { position: absolute; top: 0; right: 8%; width: min(58%, 260px); border: 7px solid; border-radius: 34px; transition: transform .45s var(--ease); }

        /* Breite Karten: Text links, Motiv rechts. Schmale Karten: Text oben, Motiv unten. */
        .world--family .world__copy, .world--care .world__copy { max-width: 56%; }
        .world--family .world__link, .world--care .world__link { margin: auto var(--gutter) var(--gutter); }
        .world--family .world__media { position: absolute; inset: 0 0 0 auto; width: 44%; min-height: 0; margin: 0; }
        .world--family .world__visual { top: 84px; right: 12%; width: min(80%, 280px); }

        .world--family { background: var(--family-soft); color: #182352; }
        .world--family::before { content: ""; position: absolute; width: 360px; height: 360px; right: -90px; bottom: -120px; border-radius: 50%; background: #b4c0ff; }
        .world--family .world__visual { border-color: #192044; box-shadow: 0 30px 50px rgba(30, 46, 125, .24); transform: rotate(4deg); }
        .world--family:hover .world__visual { transform: rotate(2deg) translateY(-6px); }

        .world--kids { background: var(--kids); color: #123772; }
        .world--kids::before { content: ""; position: absolute; width: 260px; height: 260px; right: -70px; bottom: -70px; border-radius: 50%; background: var(--kids-blue); }
        .world--kids .world__visual { border-color: #102b59; box-shadow: 0 28px 45px rgba(11, 59, 145, .25); transform: rotate(-4deg); }
        .world--kids:hover .world__visual { transform: rotate(-2deg) translateY(-6px); }

        .world--gym { background: var(--gym); color: #f7f5f2; }
        .world--gym::before { content: ""; position: absolute; width: 260px; height: 260px; right: -70px; bottom: -70px; border-radius: 50%; background: var(--gym-purple); filter: blur(2px); }
        .world--gym .world__desc { color: #bdb9c1; }
        .world--gym .world__visual { border-color: #050505; box-shadow: 0 28px 48px #0009; transform: rotate(4deg); }
        .world--gym:hover .world__visual { transform: rotate(2deg) translateY(-6px); }

        .world--care { background: var(--care); color: var(--care-ink); }
        .world--care::before { content: ""; position: absolute; inset: 0 0 0 auto; width: 44%; background: linear-gradient(130deg, rgba(255,255,255,.14), rgba(128,83,70,.15)); }
        .world--care h3 { font-size: clamp(1.9rem, 6.4cqi, 3.6rem); }
        .world--family h3 { font-size: clamp(1.9rem, 6.4cqi, 3.6rem); }
        .maison-film { position: absolute; inset: 0 0 0 56%; overflow: hidden; }

        .credo { background: var(--ink); color: #f5f7f2; }
        .credo__sentence { max-width: 1120px; font-family: "Stack Sans Notch", "Inter", sans-serif; font-size: var(--type-display); line-height: .98; letter-spacing: -.04em; text-wrap: balance; }
        .credo__sentence span { color: var(--acid); }
        .credo__lead { max-width: 640px; margin-top: 28px; color: #b8c2bc; font-size: 1.15rem; line-height: 1.65; }
        .credo__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; margin-top: clamp(56px, 7vw, 96px); border-top: 1px solid #4a564f; }
        .credo__item { padding: 28px 28px 0 0; }
        .credo__item + .credo__item { padding-left: 28px; border-left: 1px solid #4a564f; }
        .credo__item strong { display: block; color: var(--acid); font-size: 1.06rem; }
        .credo__item p { max-width: 300px; margin-top: 9px; color: #b8c2bc; }
        .credo__outro { max-width: 640px; margin-top: clamp(48px, 6vw, 80px); font-family: "Stack Sans Notch", "Inter", sans-serif; font-size: var(--type-h2-small); line-height: 1.02; letter-spacing: -.03em; text-wrap: balance; }

        .extras { padding-block: clamp(74px, 8vw, 110px); border-bottom: 1px solid var(--rule); }
        .extras__head { max-width: 720px; margin-bottom: 32px; }
        .extras h2 { font-size: var(--type-h2-small); }
        .extras__head p { max-width: 58ch; margin-top: 14px; color: var(--muted); }
        .more { border-top: 1px solid var(--ink); }
        .more__row { min-height: 88px; display: grid; grid-template-columns: minmax(170px, .8fr) minmax(0, 1.2fr) 155px 36px; align-items: center; gap: 22px; border-bottom: 1px solid var(--rule); text-decoration: none; transition: background .25s var(--ease); }
        .more__row:hover { background: rgba(251, 252, 248, .72); }
        .more__name { font-size: 1.3rem; font-weight: 790; letter-spacing: -.03em; }
        .more__desc { color: var(--muted); }
        .more__meta { color: var(--muted); font-size: .82rem; font-weight: 700; }
        .more__arrow { font-size: 1.3rem; text-align: right; }

        .journal { border-bottom: 1px solid var(--rule); }
        .journal__head { display: flex; align-items: end; justify-content: space-between; gap: 28px; margin-bottom: 34px; }
        .journal__head h2 { max-width: 840px; font-size: var(--type-h2); text-wrap: balance; }
        .journal__all { flex: 0 0 auto; padding-bottom: 7px; color: #a7351a; font-weight: 760; }
        .journal__post { display: grid; grid-template-columns: 170px minmax(0, 1fr) 38px; gap: clamp(22px, 5vw, 66px); align-items: start; padding: 30px 0; border-block: 1px solid var(--ink); text-decoration: none; }
        .journal__date { padding-top: 6px; color: var(--muted); font-size: .8rem; font-weight: 680; }
        .journal__post h3 { margin-bottom: 10px; font-size: clamp(1.8rem, 3vw, 2.8rem); transition: color .2s var(--ease); }
        .journal__post p { max-width: 650px; color: var(--muted); }
        .journal__arrow { padding-top: 5px; color: var(--signal); font-size: 1.55rem; transition: transform .2s var(--ease); }
        .journal__post:hover h3 { color: #a7351a; }
        .journal__post:hover .journal__arrow { transform: translateX(5px); }
        .journal__newsletter { margin-top: 42px; }

        .about__grid { display: grid; grid-template-columns: minmax(270px, .66fr) minmax(0, 1.34fr); gap: clamp(46px, 8vw, 110px); align-items: center; }
        .portrait { position: relative; width: min(100%, 400px); }
        .portrait img { width: 100%; height: auto; border: 1px solid var(--ink); border-radius: 20px; box-shadow: 15px 17px 0 #d7ded5; }
        .portrait figcaption { position: absolute; right: -16px; bottom: 22px; padding: 9px 14px; border: 1px solid var(--ink); border-radius: 999px; background: var(--acid); font-size: .79rem; font-weight: 760; }
        .about h2 { max-width: 830px; font-size: var(--type-h2); text-wrap: balance; }
        .about__text { max-width: 700px; margin-top: 25px; color: var(--muted); font-size: 1.1rem; line-height: 1.72; }
        .press { margin-top: 34px; display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 20px 0; border-block: 1px solid var(--rule); text-decoration: none; }
        .press:hover { color: #a7351a; }
        .press__label { display: block; color: var(--muted); font-size: .75rem; font-weight: 700; }
        .press__title { display: block; margin-top: 4px; font-weight: 740; }

        .contact { padding-block: 78px; border-top: 1px solid var(--ink); background: var(--acid); }
        .contact__inner { display: flex; align-items: center; justify-content: space-between; gap: 40px; }
        .contact h2 { max-width: 790px; font-size: var(--type-h2-small); }
        .contact p { max-width: 620px; margin-top: 14px; color: #455238; }
        .contact .button { flex: 0 0 auto; background: var(--ink); color: #fff; }
        .footer { padding-block: 28px; background: var(--ink); color: #aeb9b2; }
        .footer__inner { display: flex; align-items: center; justify-content: space-between; gap: 20px; font-size: .82rem; }
        .footer__links { display: flex; flex-wrap: wrap; gap: 20px; }
        .footer a { min-height: 44px; display: inline-flex; align-items: center; color: inherit; text-underline-offset: 4px; }

        @keyframes atlas-arrive {
            from { opacity: 0; transform: translateY(18px) rotate(1deg); }
            to { opacity: 1; transform: none; }
        }
        .atlas { animation: atlas-arrive .9s var(--ease) both; }

        @media (max-width: 1020px) {
            .hero__grid { grid-template-columns: 1fr; }
            .hero__copy { max-width: 850px; }
            .atlas { width: min(720px, 100%); min-height: 610px; }
            .credo__grid { grid-template-columns: 1fr 1fr; }
            .credo__item:nth-child(3) { padding-left: 0; border-left: 0; }
            .credo__item:nth-child(-n+2) { padding-bottom: 28px; border-bottom: 1px solid #4a564f; }
        }

        @media (max-width: 900px) {
            .worlds { grid-template-columns: 1fr; }
            .world--family, .world--care, .world--kids, .world--gym { grid-column: auto; }
        }

        @media (max-width: 760px) {
            .shell { width: min(var(--wrap), calc(100% - 28px)); }
            .nav__links a:not(.nav__mail) { display: none; }
            .hero__grid { min-height: auto; padding-block: 58px 64px; }
            .hero h1 { font-size: clamp(2.7rem, 12vw, 5.1rem); }
            .atlas { min-height: 490px; border-radius: 24px; box-shadow: 9px 11px 0 rgba(22, 32, 25, .09); }
            .atlas__label { flex-direction: column; align-items: flex-start; padding: 12px; font-size: .85rem; line-height: 1.35; }
            .atlas__label small { font-size: .73rem; }
            .atlas__family img, .atlas__gym img { width: 60%; top: 24px; }
            .atlas__kids img { width: 70%; top: 30px; left: 15%; }
            .world { min-height: 0; }
            .world__copy, .world--family .world__copy, .world--care .world__copy { max-width: none; }
            .world__link, .world--family .world__link, .world--care .world__link { margin: 22px var(--gutter) 0; }
            .world--family .world__media { position: relative; inset: auto; width: auto; min-height: 250px; margin-top: 24px; }
            .world--family .world__visual { top: 0; right: 8%; width: min(58%, 260px); }
            .world__media { min-height: 260px; }
            .credo__grid { grid-template-columns: 1fr; }
            .credo__item, .credo__item + .credo__item { padding: 22px 0; border-left: 0; border-bottom: 1px solid #4a564f; }
            .credo__item p { max-width: none; }
            .more__row { grid-template-columns: 1fr auto; gap: 7px 18px; padding-block: 18px; }
            .more__desc, .more__meta { grid-column: 1; }
            .more__arrow { grid-column: 2; grid-row: 1 / 4; align-self: center; }
            .journal__head { align-items: flex-start; flex-direction: column; }
            .journal__post { grid-template-columns: 1fr 28px; gap: 13px; }
            .journal__date { grid-column: 1 / -1; }
            .about__grid { grid-template-columns: 1fr; }
            .portrait { width: min(88%, 400px); }
            .contact__inner { align-items: flex-start; flex-direction: column; }
            .footer__inner { align-items: flex-start; flex-direction: column; }
        }

        @media (max-width: 430px) {
            .atlas { min-height: 430px; }
            .atlas__label { padding: 10px; font-size: .78rem; }
            .atlas__family img, .atlas__gym img { border-width: 3px; border-radius: 16px; }
            .world__visual, .world--family .world__visual { width: min(62%, 220px); border-width: 5px; border-radius: 26px; }
        }

        @media (max-width: 760px) {
            .world--care h3, .world--family h3 { font-size: clamp(1.9rem, 8.5cqi, 4.4rem); }
            .world--care::before { display: none; }
            .maison-film { position: relative; inset: auto; width: 100%; aspect-ratio: 4 / 5; margin-top: 24px; }
            .maison-film .maison-video { position: absolute; inset: 0; }
        }

        @media (prefers-reduced-motion: reduce) {
            html { scroll-behavior: auto; }
            *, *::before, *::after { animation-duration: .001ms !important; transition-duration: .001ms !important; }
        }
    </style>
</head>
<body>
    <a class="skip" href="#main">Zum Inhalt</a>

    <nav class="nav" aria-label="Hauptnavigation">
        <div class="shell nav__inner">
            <a class="brand" href="#top"><span class="brand__mark" aria-hidden="true"></span>Ben Kohler</a>
            <div class="nav__links">
                <a href="#produkte">Projekte</a>
                <a href="#haltung">Die Idee dahinter</a>
                <a href="/blog/">Blog</a>
                <a href="#about">Über mich</a>
                <a class="nav__mail" href="mailto:mail@benkohler.de">Schreib mir</a>
            </div>
        </div>
