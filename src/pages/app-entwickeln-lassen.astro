---
import BlogLayout from "../layouts/BlogLayout.astro";

const contactUrl = "/?thema=projekt#kontakt";
const pageUrl = "https://benkohler.de/app-entwickeln-lassen/";

const facts = [
    { value: "ab 999 €", label: "Festpreis, vorher schriftlich" },
    { value: "Jede Woche", label: "neuer Stand auf deinem iPhone" },
    { value: "Bundesweit", label: "remote, aus Ulm" },
    { value: "1 Projekt", label: "gleichzeitig, mit voller Aufmerksamkeit" },
];

const platforms = [
    {
        name: "Apple-Ökosystem",
        claim: "Mein Schwerpunkt.",
        text: "iPhone, iPad und Mac, nativ mit Swift und SwiftUI. Die App fühlt sich an wie von Apple und läuft schnell, auch offline. Veröffentlicht wird sie in deinem eigenen App-Store-Konto.",
    },
    {
        name: "Web",
        claim: "Gehört immer dazu.",
        text: "Zu jeder App gehören Website, Datenschutzerklärung und Support-Seite, ohne die der App Store sie nicht annimmt. Die Seiten baue ich. Domain und Webspace laufen auf deinen Namen: Ich richte sie dir ein und kümmere mich darum, die laufenden Kosten trägst du. Wo es sinnvoll ist, baue ich auch eine Web-Oberfläche.",
    },
    {
        name: "Android",
        claim: "Geht auf Anfrage.",
        text: "Wenn deine Nutzer auch Android haben, besprechen wir im ersten Gespräch den passenden Weg. Der Schwerpunkt bleibt Apple, damit die Qualität stimmt.",
    },
];

const offers = [
    {
        name: "Erste Version",
        claim: "Das Starterpaket: für eine Idee, die noch keine App ist.",
        text: "Wir legen zusammen fest, was in die erste Version muss und was warten kann. Dann baue ich sie. Jede Woche landet ein neuer Stand über TestFlight auf deinem iPhone.",
        price: "Festpreis ab 999 €",
        duration: "Termin steht im Angebot",
        featured: true,
    },
    {
        name: "Weiterentwicklung",
        claim: "Für eine App, die schon im Store ist.",
        text: "Ich reserviere dir feste Tage im Monat. Darin baue ich neue Funktionen, passe die App an neue iOS-Versionen an und kümmere mich um das, was deine Nutzer melden.",
        price: "Nach Absprache",
        duration: "monatlich kündbar",
    },
];

const example = {
    name: "Gießplan",
    pitch: "Eine App, die dich ans Gießen deiner Zimmerpflanzen erinnert.",
    included: [
        "Liste deiner Pflanzen mit Name, Foto und Gießrhythmus",
        "Erinnerung per Mitteilung, wenn eine Pflanze Wasser braucht",
        "Ein Tippen auf „gegossen“ setzt den Rhythmus neu",
        "Drei Bildschirme: Übersicht, Pflanze, Einstellungen",
        "Daten bleiben auf dem Gerät, keine Anmeldung",
        "Website mit Datenschutzerklärung und Support-Seite (Domain und Webspace laufen auf deinen Namen)",
        "Auf Wunsch Roadlight für Nutzerfeedback, ohne Aufpreis",
        "Veröffentlichung in deinem App-Store-Konto, Quellcode für dich",
    ],
    excluded: [
        "Konto und Anmeldung",
        "Abgleich zwischen mehreren Geräten oder Nutzern",
        "Bezahlfunktion oder Abo",
        "Eigene Server und Datenbank",
        "Eine Version für Android",
    ],
};

const proofs = [
    { name: "FamilyManager", text: "Termine, Aufgaben und Einkäufe für Familien, auch über mehrere Haushalte hinweg.", meta: "iPhone", href: "https://familymanager.pro/landing" },
    { name: "GymBo", text: "Trainingstagebuch fürs iPhone.", meta: "iPhone", href: "https://gymbo.benkohler.de/" },
    { name: "Track4Kids", text: "Kinder entdecken Lebensmittel mit Karten und Arenen.", meta: "iPhone · Beta", href: "https://track4kids.de/" },
    { name: "StarTune", text: "Songs schneller favorisieren.", meta: "macOS · Live", href: "https://startune.benkohler.de/" },
];

const steps = [
    { title: "Erstes Gespräch", text: "Wir telefonieren eine halbe Stunde. Du erzählst von deiner App, ich stelle Fragen. Das Gespräch kostet nichts." },
    { title: "Festpreis-Angebot", text: "Du bekommst schriftlich, was ich baue, was es kostet und wann es fertig ist. Der Preis steht vorher fest." },
    { title: "Entwicklung", text: "Jede Woche ein neuer Stand auf deinem iPhone. Wenn dir etwas nicht gefällt, merken wir das früh." },
    { title: "Übergabe", text: "Die App läuft in deinem App-Store-Konto. Du bekommst den Code und eine Beschreibung, wie alles zusammenhängt." },
];

const faqs = [
    { q: "Was kostet es, eine App entwickeln zu lassen?", a: "Meine Festpreise beginnen bei 999 €. Was am Ende im Angebot steht, hängt vom Umfang ab: wie viele Bildschirme, ob die App ein Konto und eine Datenbank braucht und ob sie mit anderen Diensten spricht. Nach dem ersten Gespräch bekommst du den Preis schriftlich, bevor irgendetwas losgeht." },
    { q: "Was bedeutet Festpreis?", a: "Du zahlst genau den Betrag aus dem Angebot, auch wenn die Entwicklung länger dauert als geplant. Änderungen am Umfang besprechen wir vorher und halten sie schriftlich fest." },
    { q: "Was muss ich selbst bezahlen?", a: "Die laufenden Kosten laufen auf deinen Namen: das Entwicklerkonto bei Apple sowie Domain und Webspace für die Website zur App. Ich richte das alles für dich ein und kümmere mich darum, bezahlt wird es von dir. So gehört dir später alles und du bist nicht von mir abhängig." },
    { q: "Für welche Geräte baust du Apps?", a: "Mein Schwerpunkt ist das Apple-Ökosystem: iPhone, iPad und Mac, mit Swift und SwiftUI. Eine Website zur App baue ich immer mit. Domain und Webspace dafür buchst du auf deinen Namen, die laufenden Kosten trägst du. Android geht auf Anfrage, den passenden Weg klären wir im ersten Gespräch." },
    { q: "Arbeitest du nur in Ulm?", a: "Nein, ich arbeite bundesweit. Das meiste läuft über Video und Mail. Wenn du in der Nähe von Ulm bist, können wir uns auch treffen." },
    { q: "Wann kannst du anfangen?", a: "Das hängt davon ab, ob gerade ein anderes Projekt läuft. Ich arbeite immer nur an einem gleichzeitig und sage dir im ersten Gespräch, wann es losgehen kann." },
    { q: "Wie bekomme ich Feedback von meinen Nutzern?", a: "Wenn du möchtest, nutzt du Roadlight mit, ein Feedback-Board mit Abstimmung, öffentlicher Roadmap und Changelog. Ich habe es selbst gebaut und nutze es für meine eigenen Apps. Für meine Kunden ist es kostenlos, ohne extra Gebühr." },
    { q: "Wem gehört die App und der Code?", a: "Dir. Die App läuft in deinem App-Store-Konto, und du bekommst den Quellcode mit einer Beschreibung, wie alles zusammenhängt." },
    { q: "Welche Apps passen zu dir?", a: "Apps für den Alltag: Familie, Organisation, Gesundheit, Training. An diesen Themen arbeite ich auch bei meinen eigenen Apps." },
    { q: "Was machst du nicht?", a: "Spiele. Und Projekte, die in zwei Wochen fertig sein müssen." },
];

const structuredData = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "ProfessionalService",
            "@id": "https://benkohler.de/#service",
            "name": "Ben Kohler Digital Services",
            "legalName": "Ben Kohler Digital Services",
            "logo": "https://benkohler.de/logo/logo.svg",
            "url": pageUrl,
            "image": "https://benkohler.de/images/og-default.png",
            "priceRange": "ab 999 €",
            "founder": { "@id": "https://benkohler.de/#person" },
            "address": { "@type": "PostalAddress", "addressLocality": "Ulm", "postalCode": "89073", "addressCountry": "DE" },
            "areaServed": { "@type": "Country", "name": "Deutschland" },
            "knowsLanguage": "de",
            "makesOffer": offers.map((offer, index) => ({
                "@type": "Offer",
                "itemOffered": { "@type": "Service", "name": offer.name, "description": offer.text },
                ...(index === 0 && {
                    "priceSpecification": { "@type": "PriceSpecification", "minPrice": 999, "priceCurrency": "EUR" },
                }),
            })),
        },
        {
            "@type": "FAQPage",
            "mainEntity": faqs.map((faq) => ({
                "@type": "Question",
                "name": faq.q,
                "acceptedAnswer": { "@type": "Answer", "text": faq.a },
            })),
        },
        {
            "@type": "BreadcrumbList",
            "itemListElement": [
                { "@type": "ListItem", "position": 1, "name": "Startseite", "item": "https://benkohler.de/" },
                { "@type": "ListItem", "position": 2, "name": "App entwickeln lassen", "item": pageUrl },
            ],
        },
    ],
};
---

<BlogLayout
    title="App entwickeln lassen: iPhone, iPad, Mac und Web"
    description="App entwickeln lassen zum Festpreis ab 999 €: Ben Kohler aus Ulm baut Apps fürs Apple-Ökosystem, bundesweit, mit wöchentlichen Testständen."
>
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <header class="hire-hero">
        <div class="shell">
            <p class="hire-hero__eyebrow">App-Entwicklung · Ulm · bundesweit</p>
            <h1>App entwickeln lassen: für iPhone, iPad, Mac und Web.</h1>
            <p class="hire-hero__lede">Ich bin Ben Kohler, Entwickler aus Ulm. Ich baue Apps im Auftrag, vom ersten Entwurf bis in den App Store, zum Festpreis ab 999 €. Ich arbeite immer nur an einem Projekt gleichzeitig, du hast also eine feste Ansprechperson.</p>
            <div class="actions">
                <a class="button button--primary" href={contactUrl}>Festpreis anfragen <span aria-hidden="true">↗</span></a>
                <a class="button button--quiet" href="#angebot">Was ich anbiete <span aria-hidden="true">↓</span></a>
            </div>
            <dl class="facts">
                {facts.map((fact) => (
                    <div class="facts__item"><dt>{fact.value}</dt><dd>{fact.label}</dd></div>
                ))}
            </dl>
        </div>
    </header>

    <section class="hire-section" aria-labelledby="plattform-title">
        <div class="shell">
            <div class="hire-head">
                <h2 id="plattform-title">Wofür ich Apps baue.</h2>
                <p>Der Schwerpunkt liegt auf Apple. Dort kann ich die Qualität liefern, die du von meinen eigenen Apps kennst.</p>
            </div>
            <div class="platforms">
                {platforms.map((platform) => (
                    <article class="platform">
                        <h3>{platform.name}</h3>
                        <p class="platform__claim">{platform.claim}</p>
                        <p class="platform__text">{platform.text}</p>
                    </article>
                ))}
            </div>
        </div>
    </section>

    <section class="hire-section" id="angebot" aria-labelledby="angebot-title">
        <div class="shell">
            <div class="hire-head">
                <h2 id="angebot-title">Was ich anbiete.</h2>
                <p>Zwei Pakete. Bei der ersten Version bekommst du einen Festpreis ab 999 €. Den genauen Betrag nennt dir das Angebot nach dem ersten Gespräch, bevor irgendetwas losgeht. Wie sich der Preis zusammensetzt, steht im <a href="/app-entwicklung-kosten/">Kostenratgeber</a>.</p>
            </div>
            <div class="offers">
                {offers.map((offer) => (
                    <article class:list={["offer", { "offer--featured": offer.featured }]}>
                        <h3>{offer.name}</h3>
                        <p class="offer__claim">{offer.claim}</p>
                        <p class="offer__text">{offer.text}</p>
                        <dl class="offer__facts">
                            <div><dt>Preis</dt><dd>{offer.price}</dd></div>
                            <div><dt>Dauer</dt><dd>{offer.duration}</dd></div>
                        </dl>
                    </article>
                ))}
            </div>
        </div>
    </section>

    <section class="hire-section" aria-labelledby="roadlight-title">
        <div class="shell">
            <div class="hire-head">
                <h2 id="roadlight-title">Feedback deiner Nutzer, ohne Aufpreis.</h2>
                <p>Wer bei mir eine App entwickeln lässt, kann <a href="https://roadlight.pro" rel="noopener">Roadlight</a> kostenlos mitnutzen, wenn er möchte: ein Board, auf dem deine Nutzer Wünsche einreichen und darüber abstimmen, mit öffentlicher Roadmap und Changelog. Ich habe Roadlight selbst gebaut und sammle damit das Feedback zu meinen eigenen Apps. Für dich kostet es keine zusätzliche Gebühr.</p>
            </div>
        </div>
    </section>

    <section class="hire-section" aria-labelledby="beispiel-title">
        <div class="shell">
            <div class="hire-head">
                <h2 id="beispiel-title">Ein Beispiel für das Starterpaket.</h2>
                <p>Ab 999&nbsp;€ bekommst du eine kleine, klar umrissene App. So kann das aussehen. Das Beispiel ist ausgedacht und zeigt den Umfang, nicht ein fertiges Produkt.</p>
            </div>
            <div class="example">
                <div class="example__head">
                    <h3>{example.name}</h3>
                    <p>{example.pitch}</p>
                </div>
                <div class="example__lists">
                    <div>
                        <h4>Im Starterpaket</h4>
                        <ul class="example__list">
                            {example.included.map((item) => <li>{item}</li>)}
                        </ul>
                    </div>
                    <div>
                        <h4>Nicht im Starterpaket</h4>
                        <ul class="example__list example__list--out">
                            {example.excluded.map((item) => <li>{item}</li>)}
                        </ul>
                        <p class="example__note">Brauchst du etwas davon, wird das Angebot größer. Wir besprechen es im ersten Gespräch, und du siehst den Preis, bevor ich anfange.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="hire-section" aria-labelledby="proof-title">
        <div class="shell">
            <div class="hire-head">
                <h2 id="proof-title">Meine eigenen Apps.</h2>
                <p>An ihnen kannst du sehen, wie ich arbeite. Was sich an ihnen jede Woche ändert, schreibe ich <a href="/blog/">im Blog</a> auf.</p>
            </div>
            <div class="proofs">
                {proofs.map((proof) => (
                    <a class="proof" href={proof.href} rel="noopener">
                        <span class="proof__name">{proof.name}</span>
                        <span class="proof__text">{proof.text}</span>
                        <span class="proof__meta">{proof.meta}</span>
                        <span class="proof__arrow" aria-hidden="true">↗</span>
                    </a>
                ))}
            </div>
        </div>
    </section>

    <section class="hire-section" aria-labelledby="ablauf-title">
        <div class="shell">
            <div class="hire-head">
                <h2 id="ablauf-title">So läuft es ab.</h2>
            </div>
            <ol class="steps">
                {steps.map((step) => (
                    <li class="step">
                        <h3>{step.title}</h3>
                        <p>{step.text}</p>
                    </li>
                ))}
            </ol>
        </div>
    </section>

    <section class="hire-section hire-section--faq" aria-labelledby="faq-title">
        <div class="shell faq">
            <h2 id="faq-title">Fragen und Antworten.</h2>
            <div>
                {faqs.map((faq) => (
                    <details class="faq__item">
                        <summary>{faq.q}</summary>
                        <p>{faq.a}</p>
                    </details>
                ))}
            </div>
        </div>
    </section>

    <section class="hire-contact">
        <div class="shell hire-contact__inner">
            <div>
                <h2>Erzähl mir von deiner App.</h2>
                <p>Schreib mir ein paar Sätze: was die App können soll, für wen sie ist und bis wann du sie brauchst. Ich antworte innerhalb von zwei Werktagen. Aus Ulm oder der Region? <a href="/app-entwickler-ulm/">Hier geht es zur Seite für Ulm und Neu-Ulm.</a></p>
            </div>
            <a class="button button--primary" href={contactUrl}>Projekt anfragen <span aria-hidden="true">↗</span></a>
        </div>
    </section>
</BlogLayout>

<style>
    .hire-hero { padding: clamp(64px, 9vw, 120px) 0 clamp(56px, 8vw, 96px); text-align: center; }
    .hire-hero h1 { max-width: 980px; margin: 0 auto; font-size: clamp(2.7rem, 6.6vw, 5.4rem); letter-spacing: -.05em; line-height: 1.04; text-wrap: balance; }
    .hire-hero__eyebrow { margin: 0 0 18px; color: var(--muted); font-size: clamp(1rem, 1.6vw, 1.2rem); font-weight: 600; letter-spacing: -.01em; }
    .hire-hero__lede { max-width: 660px; margin: 24px auto 0; color: var(--muted); font-size: clamp(1.1rem, 1.8vw, 1.3rem); line-height: 1.4; text-wrap: pretty; }
    .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 30px; }

    .facts { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin: clamp(44px, 6vw, 72px) 0 0; text-align: left; }
    .facts__item { padding: 24px; border-radius: 22px; background: var(--gray); }
    .facts dt { font-size: clamp(1.4rem, 2.2vw, 1.9rem); font-weight: 700; letter-spacing: -.04em; line-height: 1.1; }
    .facts dd { margin: 8px 0 0; color: var(--muted); font-size: .92rem; }

    .platforms { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
    .platform { padding: clamp(26px, 3vw, 36px); border-radius: var(--radius); background: var(--card); }
    .platform h3 { margin-bottom: 14px; font-size: clamp(1.6rem, 2.4vw, 2rem); }
    .platform__claim { margin: 0 0 10px; font-weight: 650; }
    .platform__text { margin: 0; color: var(--muted); }

    .hire-section { --card: var(--gray); padding: clamp(72px, 9vw, 120px) 0; }
    .hire-section:nth-of-type(even) { --card: #fff; background: var(--gray); }
    .hire-head { max-width: 720px; margin-bottom: clamp(32px, 4vw, 52px); }
    .hire-head h2, .faq h2 { margin-bottom: 0; font-size: clamp(2.2rem, 4.6vw, 3.6rem); letter-spacing: -.045em; text-wrap: balance; }
    .hire-head p { max-width: 58ch; margin: 18px 0 0; color: var(--muted); font-size: 1.15rem; }
    .hire-head a { color: var(--link); }
    .hire-head a:hover { text-decoration: underline; }

    .offers { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
    .offer { display: flex; flex-direction: column; padding: clamp(28px, 3.4vw, 44px); border-radius: var(--radius); background: var(--card); }
    .offer--featured { background: var(--ink); color: #f5f5f7; }
    .offer h3 { margin-bottom: 16px; font-size: clamp(1.9rem, 3vw, 2.5rem); }
    .offer--featured h3 { color: #f5f5f7; }
    .offer__claim { margin-bottom: 10px; font-weight: 650; line-height: 1.4; }
    .offer__text { margin-bottom: 26px; color: var(--muted); }
    .offer__facts { margin: auto 0 0; border-top: 1px solid var(--rule); }
    .offer__facts div { display: flex; justify-content: space-between; gap: 16px; padding-top: 12px; font-size: .92rem; }
    .offer__facts dt { color: var(--muted); }
    .offer--featured .offer__text, .offer--featured .offer__facts dt { color: #a1a1a6; }
    .offer--featured .offer__facts { border-color: #424245; }
    .offer__facts dd { margin: 0; font-weight: 650; text-align: right; }

    .example { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(28px, 5vw, 72px); padding: clamp(28px, 4vw, 52px); border-radius: var(--radius); background: var(--card); }
    .example__head h3 { margin-bottom: 14px; font-size: clamp(2rem, 3.6vw, 3rem); }
    .example__head p { margin: 0; color: var(--muted); font-size: 1.12rem; }
    .example__lists { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
    .example h4 { margin: 0 0 14px; font-size: .85rem; font-weight: 650; color: var(--muted); }
    .example__list { margin: 0; padding: 0; list-style: none; }
    .example__list li { position: relative; padding: 10px 0 10px 28px; border-top: 1px solid var(--rule); font-size: .95rem; }
    .example__list li::before { content: "✓"; position: absolute; left: 0; color: #248a3d; font-weight: 700; }
    .example__list--out li { color: var(--muted); }
    .example__list--out li::before { content: "–"; color: var(--muted); }
    .example__note { margin: 16px 0 0; color: var(--muted); font-size: .9rem; }

    .proofs { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
    .proof { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 4px 16px; padding: 28px; border-radius: var(--radius); background: var(--card); text-decoration: none; transition: transform .35s var(--ease), box-shadow .35s var(--ease); }
    .proof:hover { transform: translateY(-4px); box-shadow: 0 24px 40px -22px rgba(0, 0, 0, .22); }
    .proof__name { grid-column: 1; font-size: 1.5rem; font-weight: 700; letter-spacing: -.035em; }
    .proof__text { grid-column: 1; color: var(--muted); }
    .proof__meta { grid-column: 1; margin-top: 8px; color: var(--muted); font-size: .8rem; font-weight: 600; }
    .proof__arrow { grid-column: 2; grid-row: 1 / 4; align-self: center; color: var(--link); font-size: 1.4rem; }

    .steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin: 0; padding: 0; list-style: none; counter-reset: step; }
    .step { padding: 28px; border-radius: var(--radius); background: var(--card); counter-increment: step; }
    .step::before { content: counter(step); display: grid; place-items: center; width: 34px; height: 34px; margin-bottom: 18px; border-radius: 50%; background: var(--blue); color: #fff; font-size: .95rem; font-weight: 600; }
    .step h3 { margin-bottom: 10px; font-size: 1.5rem; }
    .step p { margin: 0; color: var(--muted); }

    .hire-section--faq { background: #fff; }
    .faq { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(36px, 6vw, 90px); }
    .faq__item { border-bottom: 1px solid var(--rule); }
    .faq__item:first-child { border-top: 1px solid var(--rule); }
    .faq__item summary { min-height: 64px; display: flex; align-items: center; justify-content: space-between; gap: 18px; cursor: pointer; font-weight: 600; letter-spacing: -.015em; list-style: none; }
    .faq__item summary::-webkit-details-marker { display: none; }
    .faq__item summary::after { content: "+"; color: var(--muted); font-size: 1.6rem; font-weight: 300; transition: transform .2s var(--ease); }
    .faq__item[open] summary::after { transform: rotate(45deg); }
    .faq__item p { max-width: 60ch; margin: 0 0 22px; color: var(--muted); }

    .hire-contact { padding-block: clamp(64px, 8vw, 104px); background: var(--gray); text-align: center; }
    .hire-contact__inner { display: flex; flex-direction: column; align-items: center; gap: 28px; }
    .hire-contact h2 { max-width: 790px; margin-bottom: 0; font-size: clamp(2rem, 4.4vw, 3.4rem); letter-spacing: -.045em; text-wrap: balance; }
    .hire-contact p { max-width: 620px; margin: 14px auto 0; color: var(--muted); font-size: 1.1rem; }
    .hire-contact p a { color: var(--link); }
    .hire-contact .button { flex: 0 0 auto; }

    @media (max-width: 1020px) {
        .offers, .platforms, .example, .example__lists, .proofs { grid-template-columns: 1fr; }
        .facts { grid-template-columns: 1fr 1fr; }
        .steps { grid-template-columns: 1fr 1fr; }
    }

    @media (max-width: 760px) {
        .steps { grid-template-columns: 1fr; }
        .faq { grid-template-columns: 1fr; }
    }

