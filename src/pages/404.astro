---
import BlogLayout from "../layouts/BlogLayout.astro";
---

<BlogLayout title="Seite nicht gefunden" description="Die angeforderte Seite wurde nicht gefunden.">
  <section class="blog-hero">
    <div class="shell blog-hero__grid">
      <h1>Hier ist nichts.</h1>
      <div>
        <p>Die Seite wurde verschoben oder hat nie existiert.</p>
        <div class="blog-hero__links"><a href="/">Zur Startseite</a><a href="/blog/">Zum Blog</a></div>
      </div>
    </div>
  </section>
</BlogLayout>
