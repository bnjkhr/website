---
import NewsletterForm from "../components/NewsletterForm.astro";
import ContactForm from "../components/ContactForm.astro";
import LangSwitch from "../components/LangSwitch.astro";
import { formatDate, OG_LOCALE, otherLang, pagePath, ui, type Lang } from "../i18n";
import { getPosts } from "../i18n/blog";
import { homeStrings } from "../i18n/home";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = homeStrings[lang];
const n = ui[lang];
const origin = "https://benkohler.de";
const absolute = (path: string) => new URL(path, origin).href;
const homePath = pagePath("home", lang);
const otherPath = pagePath("home", otherLang(lang));

// Neuester Beitrag in der Sprache der Seite. Ohne Beitrag entfällt der Block.
const [latestPost] = await getPosts(lang);
const latestHref = latestPost ? `${pagePath("blog", lang)}${latestPost.id}/` : undefined;

const structuredData = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "WebSite",
            "@id": "https://benkohler.de/#website",
            "url": absolute(homePath),
            "name": "Ben Kohler Digital Services",
            "alternateName": "Ben Kohler",
            "inLanguage": t.jsonLd.inLanguage,
            "publisher": { "@id": "https://benkohler.de/#person" },
        },
        {
            "@type": "Person",
            "@id": "https://benkohler.de/#person",
            "name": "Ben Kohler",
            "url": "https://benkohler.de/",
            "image": "https://benkohler.de/images/ben-profile.jpg",
            "jobTitle": t.jsonLd.jobTitle,
            "address": { "@type": "PostalAddress", "addressLocality": "Ulm", "addressCountry": "DE" },
            "knowsAbout": t.jsonLd.knowsAbout,
        },
    ],
};
---
<!doctype html>
<html lang={lang}>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content={t.seo.description}>
    <meta name="theme-color" content="#fbfbfd">
    <meta name="google-site-verification" content="BTTiqd4pViSqZN7GCZwKtEMVipfOYplPx7w8ON70AGk" />
    <meta name="robots" content="index, follow, max-image-preview:large">
    <link rel="canonical" href={absolute(homePath)}>
    <link rel="alternate" hreflang="de" href={absolute(pagePath("home", "de"))}>
    <link rel="alternate" hreflang="en" href={absolute(pagePath("home", "en"))}>
    <link rel="alternate" hreflang="x-default" href={absolute(pagePath("home", "de"))}>
    <link rel="alternate" type="application/rss+xml" title={t.seo.rssTitle} href={absolute(pagePath("rss", lang))}>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">
    <title>{t.seo.title}</title>
    <meta property="og:title" content={t.seo.title}>
    <meta property="og:description" content={t.seo.description}>
    <meta property="og:type" content="website">
    <meta property="og:url" content={absolute(homePath)}>
    <meta property="og:site_name" content="Ben Kohler">
    <meta property="og:locale" content={OG_LOCALE[lang]}>
    <meta property="og:image" content="https://benkohler.de/images/og-default.png">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:image" content="https://benkohler.de/images/og-default.png">
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
    <style is:global>
        @font-face {
            font-family: "Inter";
            src: url("/fonts/Inter-latin.woff2") format("woff2");
            font-style: normal;
            font-weight: 100 900;
            font-display: swap;
        }

        :root {
            --bg: #fbfbfd;
            --gray: #f5f5f7;
            --ink: #1d1d1f;
            --muted: #6e6e73;
            --rule: #d2d2d7;
            --blue: #0071e3;
            --link: #0066cc;
            --wrap: 1120px;
            --radius: 28px;
            --ease: cubic-bezier(.22, .61, .36, 1);

            /* Tokens, die ContactForm und NewsletterForm auf der Startseite übernehmen */
            --form-bg: var(--gray);
            --form-muted: var(--muted);
            --section-rule: 0 solid transparent;
            --field-border: 1px solid var(--rule);
            --field-radius: 12px;
            --field-bg: #fff;
            --btn-bg: var(--blue);
            --btn-bg-hover: #0077ed;
            --btn-border: 1px solid transparent;
            --btn-radius: 980px;
            --card-bg: var(--gray);
            --card-border: 0 solid transparent;
            --card-shadow: none;
            --type-h2-small: clamp(2rem, 4vw, 3rem);
        }

        * { box-sizing: border-box; }
        html { scroll-behavior: smooth; scroll-padding-top: 64px; }
        body {
            margin: 0;
            color: var(--ink);
            background: var(--bg);
            font-family: "Inter", -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
            font-size: 17px;
            line-height: 1.5;
            letter-spacing: -.01em;
            -webkit-font-smoothing: antialiased;
            overflow-x: hidden;
        }

        img { display: block; max-width: 100%; height: auto; }
        a { color: inherit; }
        h1, h2, h3, p, figure { margin: 0; }
        h1, h2, h3, .contact h2, .newsletter h2 { font-family: "Inter", -apple-system, BlinkMacSystemFont, sans-serif; font-weight: 700; letter-spacing: -.04em; line-height: 1.06; }

        ::selection { background: #b3d7ff; color: var(--ink); }
        :focus-visible { outline: 2px solid var(--blue); outline-offset: 3px; }

        .skip { position: fixed; top: -80px; left: 20px; z-index: 100; padding: 12px 18px; border-radius: 10px; background: var(--ink); color: #fff; }
        .skip:focus { top: 20px; }
        .shell { width: min(var(--wrap), calc(100% - 48px)); margin-inline: auto; }

        /* Navigation */
        .nav { position: sticky; top: 0; z-index: 50; background: rgba(251, 251, 253, .8); backdrop-filter: saturate(180%) blur(20px); -webkit-backdrop-filter: saturate(180%) blur(20px); border-bottom: 1px solid rgba(0, 0, 0, .08); }
        .nav__inner { min-height: 48px; display: flex; align-items: center; justify-content: space-between; gap: 28px; }
        .brand { display: inline-flex; align-items: center; gap: 9px; text-decoration: none; font-size: .95rem; font-weight: 650; letter-spacing: -.02em; }
        .brand__mark { flex: 0 0 auto; width: 22px; height: 22px; background: url("/logo/zeichen.svg") center / contain no-repeat; }
        .nav__links { display: flex; align-items: center; gap: 2px; }
        .nav__links a { min-height: 44px; display: inline-flex; align-items: center; padding: 0 12px; color: rgba(29, 29, 31, .8); text-decoration: none; font-size: .78rem; letter-spacing: -.005em; transition: color .2s; }
        .nav__links a:hover { color: #000; }
        .nav__short { display: none; }
        .nav__links .nav__mail { margin-left: 6px; padding: 0 14px; min-height: 28px; border-radius: 980px; background: var(--blue); color: #fff; }
        .nav__links .nav__mail:hover { background: var(--btn-bg-hover); color: #fff; }

        /* Links und Buttons */
        .btn { min-height: 44px; display: inline-flex; align-items: center; padding: 0 22px; border-radius: 980px; background: var(--blue); color: #fff; text-decoration: none; font-size: 1.05rem; transition: background .2s; }
        .btn:hover { background: var(--btn-bg-hover); }
        .link { display: inline-flex; align-items: center; min-height: 44px; color: var(--link); text-decoration: none; font-size: 1.05rem; }
        .link::after { content: "›"; margin-left: .3em; font-size: 1.2em; line-height: 1; transition: transform .2s var(--ease); }
        .link:hover { text-decoration: underline; text-underline-offset: .2em; }
        .link:hover::after { transform: translateX(3px); }
        .actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 4px 26px; margin-top: 22px; }

        /* Gerät */
        .device { position: relative; width: var(--device-w, 300px); border: calc(var(--device-w, 300px) * .03) solid #131315; border-radius: calc(var(--device-w, 300px) * .173); overflow: hidden; background: #000; box-shadow: 0 0 0 1.5px #4a4a4f, 0 50px 90px -30px rgba(0, 0, 0, .45); }
        .device img { width: 100%; aspect-ratio: 1206 / 2622; object-fit: cover; }
        .stage { position: relative; display: flex; justify-content: center; overflow: hidden; }

        /* Hero */
        .hero { padding-top: clamp(64px, 9vw, 120px); text-align: center; background: var(--bg); overflow: hidden; }
        .hero h1 { font-size: clamp(3.2rem, 9vw, 6.4rem); letter-spacing: -.05em; line-height: 1.02; text-wrap: balance; }
        .hero__lede { max-width: 640px; margin: 22px auto 0; color: var(--muted); font-size: clamp(1.15rem, 2vw, 1.4rem); line-height: 1.4; letter-spacing: -.015em; text-wrap: balance; }
        .hero .stage { --device-w: min(290px, 40vw); height: clamp(380px, 54vw, 620px); margin-top: clamp(44px, 6vw, 72px); gap: clamp(14px, 3vw, 40px); align-items: flex-start; }
        .hero .device--b { margin-top: clamp(40px, 6vw, 84px); }

        /* Projekt-Kapitel */
        .chapter { position: relative; padding-top: clamp(80px, 11vw, 150px); text-align: center; overflow: hidden; }
        .chapter__eyebrow { display: block; margin-bottom: 14px; font-size: clamp(1.1rem, 2vw, 1.4rem); font-weight: 600; letter-spacing: -.02em; }
        .chapter h2 { font-size: clamp(3rem, 8vw, 5.8rem); letter-spacing: -.05em; }
        .chapter__claim { max-width: 22ch; margin: 18px auto 0; font-size: clamp(1.4rem, 3vw, 2.1rem); font-weight: 600; letter-spacing: -.03em; line-height: 1.18; text-wrap: balance; }
        .chapter__desc { max-width: 560px; margin: 16px auto 0; font-size: clamp(1.02rem, 1.6vw, 1.2rem); line-height: 1.45; text-wrap: pretty; }
        .chapter .stage { --device-w: min(330px, 70vw); height: clamp(420px, 62vw, 640px); margin-top: clamp(40px, 6vw, 72px); align-items: flex-start; }
        .chapter--family { background: var(--gray); }
        .chapter--family .chapter__eyebrow { color: #34703d; }
        .chapter--family .chapter__desc { color: var(--muted); }
        .chapter--gym { background: #000; color: #f5f5f7; }
        .chapter--gym .chapter__eyebrow { color: #7fe3a0; }
        .chapter--gym .chapter__desc { color: #a1a1a6; }
        .chapter--gym .link { color: #2997ff; }
        .chapter--gym .device { border-color: #1c1c1e; box-shadow: 0 0 0 1.5px #3a3a3e, 0 50px 90px -30px rgba(120, 90, 255, .35); }
        .chapter--care { background: #f1e7e1; color: #1b2a36; padding-bottom: clamp(80px, 11vw, 150px); }
        .chapter--care .chapter__eyebrow { color: #8a5b4c; }
        .chapter--care .chapter__desc { color: #5f5a58; }
        .film { width: min(980px, calc(100% - 48px)); margin: clamp(40px, 6vw, 72px) auto 0; aspect-ratio: 16 / 9; border-radius: var(--radius); overflow: hidden; background: #d9c8bf; box-shadow: 0 40px 80px -30px rgba(60, 35, 25, .4); }
        .maison-video { display: block; width: 100%; height: 100%; object-fit: cover; }

        /* Haltung */
        .credo { padding-block: clamp(100px, 14vw, 200px); background: var(--bg); }
        .credo__sentence { max-width: 1000px; font-size: clamp(2.4rem, 6.2vw, 4.8rem); letter-spacing: -.045em; line-height: 1.06; text-wrap: balance; }
        .credo__sentence .w { transition: color .35s var(--ease); }
        .js .credo__sentence .w { color: #c9c9ce; }
        .js .credo__sentence .w.on { color: var(--ink); }
        .credo__lead { max-width: 640px; margin-top: 36px; color: var(--muted); font-size: clamp(1.1rem, 1.8vw, 1.3rem); line-height: 1.5; text-wrap: pretty; }
        .credo__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: clamp(56px, 7vw, 96px); }
        .credo__item { padding: 32px 30px 36px; border-radius: var(--radius); background: var(--gray); }
        .credo__item strong { display: block; font-size: 1.5rem; letter-spacing: -.03em; }
        .credo__item p { margin-top: 10px; color: var(--muted); }
        .credo__outro { margin-top: clamp(48px, 6vw, 80px); font-size: clamp(1.6rem, 3.2vw, 2.4rem); font-weight: 600; letter-spacing: -.035em; text-wrap: balance; }

        /* Weitere Projekte */
        .extras { padding-block: clamp(72px, 9vw, 120px); background: var(--gray); }
        .extras h2, .journal h2, .about h2 { font-size: clamp(2.2rem, 5vw, 3.6rem); letter-spacing: -.045em; text-wrap: balance; }
        .extras__head p { max-width: 54ch; margin-top: 14px; color: var(--muted); font-size: 1.15rem; }
        .more { display: grid; grid-template-columns: repeat(6, 1fr); gap: 20px; margin-top: clamp(32px, 4vw, 52px); }
        .card { grid-column: span 2; display: flex; flex-direction: column; min-height: 230px; padding: 30px; border-radius: var(--radius); background: #fff; text-decoration: none; transition: transform .35s var(--ease), box-shadow .35s var(--ease); }
        .card:nth-child(n+4) { grid-column: span 3; }
        .card:hover { transform: translateY(-4px); box-shadow: 0 24px 40px -22px rgba(0, 0, 0, .22); }
        .card__meta { color: var(--muted); font-size: .8rem; font-weight: 600; letter-spacing: 0; }
        .card__name { display: block; margin-top: 10px; font-size: 1.7rem; font-weight: 700; letter-spacing: -.035em; }
        .card__desc { margin-top: 8px; color: var(--muted); }
        .card__arrow { margin-top: auto; padding-top: 18px; color: var(--link); font-size: 1.4rem; line-height: 1; }

        /* Blog */
        .journal { padding-block: clamp(72px, 9vw, 120px); }
        .journal__head { display: flex; align-items: end; justify-content: space-between; gap: 28px; margin-bottom: clamp(28px, 4vw, 44px); }
        .journal__head h2 { max-width: 760px; }
        .journal__post { display: block; padding: clamp(28px, 4vw, 48px); border-radius: var(--radius); background: var(--gray); text-decoration: none; transition: background .25s; }
        .journal__post:hover { background: #ededf0; }
        .journal__date { display: block; color: var(--muted); font-size: .85rem; font-weight: 600; }
        .journal__post h3 { max-width: 22ch; margin-top: 12px; font-size: clamp(1.8rem, 3.6vw, 2.8rem); text-wrap: balance; }
        .journal__post p { max-width: 640px; margin-top: 14px; color: var(--muted); }
        .journal__more { display: inline-block; margin-top: 18px; color: var(--link); }
        .journal__more::after { content: " ›"; }
        .journal__newsletter { margin-top: 28px; }

        /* Über mich */
        .about { padding-block: clamp(72px, 9vw, 120px); }
        .about__grid { display: grid; grid-template-columns: minmax(240px, .6fr) minmax(0, 1.4fr); gap: clamp(40px, 8vw, 110px); align-items: center; }
        .portrait { width: min(100%, 380px); }
        .portrait img { width: 100%; border-radius: var(--radius); box-shadow: 0 30px 60px -30px rgba(0, 0, 0, .35); }
        .portrait figcaption { margin-top: 14px; color: var(--muted); font-size: .85rem; }
        .about__text { max-width: 620px; margin-top: 22px; color: var(--muted); font-size: 1.15rem; line-height: 1.6; text-wrap: pretty; }
        .press { display: flex; align-items: center; justify-content: space-between; gap: 24px; max-width: 620px; margin-top: 30px; padding: 20px 24px; border-radius: 20px; background: var(--gray); text-decoration: none; transition: background .25s; }
        .press:hover { background: #ededf0; }
        .press__label { display: block; color: var(--muted); font-size: .78rem; font-weight: 600; }
        .press__title { display: block; margin-top: 3px; font-weight: 600; letter-spacing: -.015em; }
        .press span[aria-hidden] { color: var(--link); font-size: 1.2rem; }

        .footer { padding-block: 22px; background: var(--gray); border-top: 1px solid var(--rule); color: var(--muted); }
        .footer__inner { display: flex; align-items: center; justify-content: space-between; gap: 20px; font-size: .78rem; }
        .footer__links { display: flex; flex-wrap: wrap; gap: 4px 20px; }
        .footer a { min-height: 44px; display: inline-flex; align-items: center; color: inherit; text-decoration: none; }
        .footer a:hover { color: var(--ink); text-decoration: underline; }

        /* Scrollbasierte Bewegung (Parallax). Ohne Unterstützung oder mit „Bewegung reduzieren“ bleibt alles ruhig. */
        @supports (animation-timeline: view()) {
            @media (prefers-reduced-motion: no-preference) {
                @keyframes hero-copy { to { opacity: 0; transform: translateY(70px); } }
                @keyframes hero-a { to { transform: translateY(-70px) scale(1.04); } }
                @keyframes hero-b { to { transform: translateY(-150px) scale(1.04); } }
                @keyframes rise { from { transform: translateY(110px); } to { transform: translateY(-40px); } }
                @keyframes grow { from { transform: scale(.9); } to { transform: scale(1); } }
                @keyframes fade-up { from { opacity: 0; transform: translateY(36px); } to { opacity: 1; transform: none; } }

                .hero__copy { animation: hero-copy linear both; animation-timeline: scroll(root); animation-range: 0 520px; }
                .hero .device--a { animation: hero-a linear both; animation-timeline: scroll(root); animation-range: 0 640px; }
                .hero .device--b { animation: hero-b linear both; animation-timeline: scroll(root); animation-range: 0 640px; }
                .chapter .device { animation: rise linear both; animation-timeline: view(); animation-range: cover; }
                .film { animation: grow linear both; animation-timeline: view(); animation-range: entry 0% cover 45%; }
                .reveal { animation: fade-up linear both; animation-timeline: view(); animation-range: entry 5% entry 55%; }
            }
        }

        @media (max-width: 900px) {
            .more { grid-template-columns: 1fr 1fr; }
            .card, .card:nth-child(n+4) { grid-column: auto; }
            .about__grid { grid-template-columns: 1fr; }
            .portrait { width: min(70%, 320px); }
        }

        @media (max-width: 760px) {
            .shell { width: min(var(--wrap), calc(100% - 36px)); }
            .nav__links a:not(.nav__hire):not([data-lang]) { display: none; }
            .nav__links .nav__hire { margin-left: 0; color: var(--link); font-size: .85rem; }
            .nav__long { display: none; }
            .nav__short { display: inline; }
            .credo__grid { grid-template-columns: 1fr; }
            .journal__head { align-items: flex-start; flex-direction: column; }
            .footer__inner { align-items: flex-start; flex-direction: column; }
        }

        @media (max-width: 560px) {
            .more { grid-template-columns: 1fr; }
            .card { min-height: 0; }
            .press { padding: 18px; }
        }

        @media (prefers-reduced-motion: reduce) {
            html { scroll-behavior: auto; }
            *, *::before, *::after { animation-duration: .001ms !important; transition-duration: .001ms !important; }
        }
    </style>
</head>
<body>
    <a class="skip" href="#main">{n.skip}</a>

    <nav class="nav" aria-label={n.nav.label}>
        <div class="shell nav__inner">
            <a class="brand" href="#top"><span class="brand__mark" aria-hidden="true"></span>Ben Kohler</a>
            <div class="nav__links">
                <a href="#produkte">{n.nav.projects}</a>
                <a href="#haltung">{n.nav.idea}</a>
                <a href={pagePath("blog", lang)}>{n.nav.blog}</a>
                <a class="nav__hire" href={pagePath("hire", lang)}><span class="nav__long">{n.nav.hire}</span><span class="nav__short">{n.nav.hireShort}</span></a>
                <a href="#about">{n.nav.about}</a>
                <a class="nav__mail" href="#kontakt">{n.nav.contact}</a>
                <LangSwitch lang={lang} currentPath={homePath} alternatePath={otherPath} />
            </div>
        </div>
    </nav>

    <main id="main" tabindex="-1">
        <header class="hero" id="top">
            <div class="shell">
                <div class="hero__copy">
                    <h1>{t.hero.title}</h1>
                    <p class="hero__lede">{t.hero.lede}</p>
                    <div class="actions">
                        <a class="btn" href="#produkte">{t.hero.ctaProjects}</a>
                        <a class="link" href="#haltung">{t.hero.ctaIdea}</a>
                    </div>
                </div>
            </div>
            <div class="stage" aria-hidden="true">
                <div class="device device--a"><img decoding="async" width="1206" height="2622" src="/images/indie-preview/familymanager-heute.png" alt={t.hero.deviceAlt.familymanager}></div>
                <div class="device device--b"><img decoding="async" width="1260" height="2736" src="/images/indie-preview/gymbo-heute.png" alt={t.hero.deviceAlt.gymbo}></div>
            </div>
        </header>

        <div id="produkte">
            <section class="chapter chapter--family" id="familymanager" aria-labelledby="familymanager-title">
                <div class="shell">
                    <span class="chapter__eyebrow">{t.familymanager.eyebrow}</span>
                    <h2 id="familymanager-title">FamilyManager</h2>
                    <p class="chapter__claim">{t.familymanager.claim}</p>
                    <p class="chapter__desc">{t.familymanager.desc}</p>
                    <div class="actions"><a class="link" href="https://familymanager.pro/landing" rel="noopener">{t.familymanager.link}</a></div>
                </div>
                <div class="stage"><div class="device"><img loading="lazy" decoding="async" width="1206" height="2622" src="/images/indie-preview/familymanager-heute.png" alt={t.familymanager.alt}></div></div>
            </section>

            <section class="chapter chapter--gym" id="gymbo" aria-labelledby="gymbo-title">
                <div class="shell">
                    <span class="chapter__eyebrow">{t.gymbo.eyebrow}</span>
                    <h2 id="gymbo-title">GymBo</h2>
                    <p class="chapter__claim">{t.gymbo.claim}</p>
                    <p class="chapter__desc">{t.gymbo.desc}</p>
                    <div class="actions"><a class="link" href="https://gymbo.benkohler.de/" rel="noopener">{t.gymbo.link}</a></div>
                </div>
                <div class="stage"><div class="device"><img loading="lazy" decoding="async" width="1206" height="2622" src="/images/indie-preview/gymbo-aktivitaet.png" alt={t.gymbo.alt}></div></div>
            </section>

            <section class="chapter chapter--care" id="maison-benchris" aria-labelledby="maison-title">
                <div class="shell">
                    <span class="chapter__eyebrow">{t.maison.eyebrow}</span>
                    <h2 id="maison-title">MAISON BENCHRIS</h2>
                    <p class="chapter__claim">{t.maison.claim}</p>
                    <p class="chapter__desc">{t.maison.desc}</p>
                    <div class="actions"><a class="link" href="https://maison-benchris.de/" rel="noopener">{t.maison.link}</a></div>
                </div>
                <div class="film"><video class="maison-video" src="https://maison-benchris.de/mbc/hero.mp4" autoplay muted loop playsinline preload="metadata" aria-hidden="true"></video></div>
            </section>
        </div>

        <section class="credo" id="haltung">
            <div class="shell">
                <h2 class="credo__sentence" data-words>{t.credo.sentence}</h2>
                <p class="credo__lead reveal">{t.credo.lead}</p>
                <div class="credo__grid">
                    {t.credo.items.map((item) => (
                        <div class="credo__item reveal"><strong>{item.title}</strong><p>{item.text}</p></div>
                    ))}
                </div>
                <p class="credo__outro reveal">{t.credo.outro}</p>
            </div>
        </section>

        <section class="extras" aria-labelledby="extras-title">
            <div class="shell">
                <div class="extras__head reveal">
                    <h2 id="extras-title">{t.extras.title}</h2>
                    <p>{t.extras.intro}</p>
                </div>
                <div class="more">
                    {t.extras.cards.map((card) => (
                        <a class="card" id={card.id} href={card.href} rel="noopener"><span class="card__meta">{card.meta}</span><span class="card__name">{card.name}</span><span class="card__desc">{card.desc}</span><span class="card__arrow" aria-hidden="true">↗</span></a>
                    ))}
                </div>
            </div>
        </section>

        <section class="journal" aria-labelledby="journal-title">
            <div class="shell">
                <div class="journal__head reveal">
                    <h2 id="journal-title">{t.journal.title}</h2>
                    <a class="link" href={pagePath("blog", lang)}>{t.journal.allPosts}</a>
                </div>
                {latestPost && (
                    <a class="journal__post reveal" href={latestHref}>
                        <span class="journal__date">{formatDate(latestPost.data.publishedAt, lang)}</span>
                        <h3>{latestPost.data.title}</h3>
                        <p>{latestPost.data.description}</p>
                        <span class="journal__more">{t.journal.readPost}</span>
                    </a>
                )}
                <div class="journal__newsletter">
                    <NewsletterForm compact lang={lang} />
                </div>
            </div>
        </section>

        <section class="about" id="about">
            <div class="shell about__grid">
                <figure class="portrait reveal">
                    <img loading="lazy" decoding="async" src="/images/ben-profile.webp" width="600" height="800" alt={t.about.portraitAlt}>
                    <figcaption>{t.about.caption}</figcaption>
                </figure>
                <div class="reveal">
                    <h2>{t.about.title}</h2>
                    <p class="about__text">{t.about.text}</p>
                    <a class="press" href="https://happy-bootstrapping.de/ben-kohler-familymanager-familien-app-neben-dem-vollzeitjob-184/" rel="noopener">
                        <span><span class="press__label">{t.about.pressLabel}</span><span class="press__title">{t.about.pressTitle}</span></span>
                        <span aria-hidden="true">↗</span>
                    </a>
                </div>
            </div>
        </section>

        <ContactForm lang={lang} />
    </main>

    <footer class="footer">
        <div class="shell footer__inner">
            <span>{n.footer.copyright}</span>
            <div class="footer__links"><a href={pagePath("blog", lang)}>{n.footer.blog}</a><a href="/impressum.html">{n.footer.imprint}</a><a href="/datenschutz.html">{n.footer.privacy}</a><a href="https://www.threads.com/@ben.kohler_" rel="noopener">{n.footer.threads}</a></div>
        </div>
    </footer>
    <script>
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

        // Video pausiert bei „Bewegung reduzieren“.
        const maisonVideos = document.querySelectorAll<HTMLVideoElement>('.maison-video');
        function updateVideoMotion() {
            maisonVideos.forEach(video => {
                if (reducedMotion.matches) video.pause();
                else video.play().catch(() => {});
            });
        }
        maisonVideos.forEach(video => video.addEventListener('loadeddata', updateVideoMotion));
        reducedMotion.addEventListener('change', updateVideoMotion);
        updateVideoMotion();

        // Der Haltungssatz wird beim Scrollen Wort für Wort dunkel. Ohne JS oder bei reduzierter Bewegung steht er sofort komplett da.
        const sentence = document.querySelector<HTMLElement>('[data-words]');
        if (sentence && !reducedMotion.matches) {
            const words = (sentence.textContent ?? '').trim().split(/\s+/);
            sentence.setAttribute('aria-label', words.join(' '));
            sentence.innerHTML = words.map(word => `<span class="w" aria-hidden="true">${word}</span>`).join(' ');
            document.documentElement.classList.add('js');
            const spans = [...sentence.querySelectorAll<HTMLElement>('.w')];
            let queued = false;
            const update = () => {
                queued = false;
                const rect = sentence.getBoundingClientRect();
                const start = window.innerHeight * 0.85;
                const end = window.innerHeight * 0.35;
                const progress = Math.min(1, Math.max(0, (start - rect.top) / (start - end + rect.height * 0.5)));
                const lit = Math.round(progress * spans.length);
                spans.forEach((span, i) => span.classList.toggle('on', i < lit));
            };
            const schedule = () => { if (!queued) { queued = true; requestAnimationFrame(update); } };
            window.addEventListener('scroll', schedule, { passive: true });
            window.addEventListener('resize', schedule);
            update();
        }
    </script>
</body>
</html>
