---
import "../styles/blog.css";

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  type?: "website" | "article";
  publishedAt?: Date;
  updatedAt?: Date;
  heroImage?: string;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  type = "website",
  publishedAt,
  updatedAt,
  heroImage,
} = Astro.props;
const canonical = new URL(canonicalPath, Astro.site);
const socialImage = heroImage ? new URL(heroImage, Astro.site) : undefined;
const pageTitle = title === "Blog" ? "Blog · Ben Kohler" : `${title} · Ben Kohler`;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#eef1ea" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && <meta name="twitter:card" content="summary_large_image" />}
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Ben Kohler Blog" href={new URL("/rss.xml", Astro.site)} />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip" href="#main">Zum Inhalt</a>
    <nav class="nav" aria-label="Hauptnavigation">
      <div class="shell nav__inner">
        <a class="brand" href="/"><span class="brand__mark" aria-hidden="true"></span>Ben Kohler</a>
        <div class="nav__links">
          <a href="/#produkte">Projekte</a>
          <a href="/blog/" aria-current="page">Blog</a>
          <a href="/#about">Über mich</a>
          <a class="nav__mail" href="mailto:mail@benkohler.de">Schreib mir</a>
        </div>
      </div>
    </nav>
    <main class="blog-main" id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="footer">
      <div class="shell footer__inner">
        <span>© 2026 Ben Kohler · Ulm</span>
        <div class="footer__links">
          <a href="/impressum.html">Impressum</a>
          <a href="/datenschutz.html">Datenschutz</a>
          <a href="/rss.xml">RSS</a>
        </div>
      </div>
    </footer>
  </body>
</html>
