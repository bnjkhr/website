---
import "../styles/blog.css";
import LangSwitch from "../components/LangSwitch.astro";
import { OG_LOCALE, otherLang, pagePath, ui, type Lang } from "../i18n";

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  type?: "website" | "article";
  publishedAt?: Date;
  updatedAt?: Date;
  heroImage?: string;
  /** Sprache der Seite. */
  lang?: Lang;
  /** Pfad der Gegenseite in der anderen Sprache (Umschalter, hreflang). */
  alternatePath?: string;
  /** false, wenn alternatePath nur ein Ausweichziel ist und keine echte Übersetzung (dann kein hreflang). */
  alternateIsTranslation?: boolean;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  type = "website",
  publishedAt,
  updatedAt,
  heroImage,
  lang = "de",
  alternatePath,
  alternateIsTranslation = true,
} = Astro.props;
const t = ui[lang];
const home = pagePath("home", lang);
const canonical = new URL(canonicalPath, Astro.site);
const current = (href: string) => (Astro.url.pathname.startsWith(href) ? "page" : undefined);
const hreflangs = alternatePath && alternateIsTranslation
  ? (() => {
      const paths = { [lang]: canonicalPath, [otherLang(lang)]: alternatePath } as Record<Lang, string>;
      return [
        { hreflang: "de", href: new URL(paths.de, Astro.site) },
        { hreflang: "en", href: new URL(paths.en, Astro.site) },
        { hreflang: "x-default", href: new URL(paths.de, Astro.site) },
      ];
    })()
  : [];
const socialImage = new URL(heroImage ?? "/images/og-default.png", Astro.site);
const pageTitle = title === t.blog.title ? "Blog · Ben Kohler" : `${title} · Ben Kohler`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fbfbfd" />
    <meta name="google-site-verification" content="BTTiqd4pViSqZN7GCZwKtEMVipfOYplPx7w8ON70AGk" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Ben Kohler" />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
    <link rel="canonical" href={canonical} />
    {hreflangs.map((link) => <link rel="alternate" hreflang={link.hreflang} href={link.href} />)}
    <link rel="alternate" type="application/rss+xml" title={t.blog.rssTitle} href={new URL(pagePath("rss", lang), Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{pageTitle}</title>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <nav class="nav" aria-label={t.nav.label}>
      <div class="shell nav__inner">
        <a class="brand" href={home}><span class="brand__mark" aria-hidden="true"></span>Ben Kohler</a>
        <div class="nav__links">
          <a href={`${home}#produkte`}>{t.nav.projects}</a>
          <a href={pagePath("blog", lang)} aria-current={current(pagePath("blog", lang))}>{t.nav.blog}</a>
          <a class="nav__hire" href={pagePath("hire", lang)} aria-current={current(pagePath("hire", lang))}><span class="nav__long">{t.nav.hire}</span><span class="nav__short">{t.nav.hireShort}</span></a>
          <a href={`${home}#about`}>{t.nav.about}</a>
          <a class="nav__mail" href={`${home}#kontakt`}>{t.nav.contact}</a>
          <LangSwitch lang={lang} currentPath={canonicalPath} alternatePath={alternatePath} />
        </div>
      </div>
    </nav>
    <main class="blog-main" id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="footer">
      <div class="shell footer__inner">
        <span>{t.footer.copyright}</span>
        <div class="footer__links">
          <a href={pagePath("cost", lang)}>{t.footer.cost}</a>
          <a href={pagePath("ulm", lang)}>{t.footer.ulm}</a>
          {/* Impressum und Datenschutz sind rechtsverbindlich und nur auf Deutsch vorhanden. */}
          <a href="/impressum.html" hreflang={lang === "en" ? "de" : undefined}>{t.footer.imprint}</a>
          <a href="/datenschutz.html" hreflang={lang === "en" ? "de" : undefined}>{t.footer.privacy}</a>
          <a href={pagePath("rss", lang)}>{t.footer.rss}</a>
        </div>
      </div>
    </footer>
  </body>
</html>
