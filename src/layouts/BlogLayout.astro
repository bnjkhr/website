---
import "../styles/blog.css";

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  type?: "website" | "article";
  publishedAt?: Date;
  updatedAt?: Date;
  heroImage?: string;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  type = "website",
  publishedAt,
  updatedAt,
  heroImage,
} = Astro.props;
const canonical = new URL(canonicalPath, Astro.site);
const current = (href: string) => (Astro.url.pathname.startsWith(href) ? "page" : undefined);
const socialImage = new URL(heroImage ?? "/images/og-default.png", Astro.site);
const pageTitle = title === "Blog" ? "Blog · Ben Kohler" : `${title} · Ben Kohler`;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#eef1ea" />
    <meta name="google-site-verification" content="BTTiqd4pViSqZN7GCZwKtEMVipfOYplPx7w8ON70AGk" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Ben Kohler" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Ben Kohler Blog" href={new URL("/rss.xml", Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{pageTitle}</title>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Zum Inhalt</a>
    <nav class="nav" aria-label="Hauptnavigation">
      <div class="shell nav__inner">
        <a class="brand" href="/"><span class="brand__mark" aria-hidden="true"></span>Ben Kohler</a>
        <div class="nav__links">
          <a href="/#produkte">Projekte</a>
          <a href="/blog/" aria-current={current("/blog/")}>Blog</a>
          <a class="nav__hire" href="/app-entwickeln-lassen/" aria-current={current("/app-entwickeln-lassen/")}><span class="nav__long">App entwickeln lassen</span><span class="nav__short">Projekt anfragen</span></a>
          <a href="/#about">Über mich</a>
          <a class="nav__mail" href="mailto:mail@benkohler.de">Schreib mir</a>
        </div>
      </div>
    </nav>
    <main class="blog-main" id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="footer">
      <div class="shell footer__inner">
        <span>© 2026 Ben Kohler Digital Services · Ulm</span>
        <div class="footer__links">
          <a href="/app-entwicklung-kosten/">Was kostet eine App?</a>
          <a href="/app-entwickler-ulm/">App-Entwickler Ulm</a>
          <a href="/impressum.html">Impressum</a>
          <a href="/datenschutz.html">Datenschutz</a>
          <a href="/rss.xml">RSS</a>
        </div>
      </div>
    </footer>
  </body>
</html>
