# Resend API key with permission to send email and manage contacts.
RESEND_API_KEY=re_...

# Create a segment for confirmed website subscribers.
# Use a separate test segment for the Vercel "Preview" environment.
RESEND_NEWSLETTER_SEGMENT_ID=...

# Optional but recommended: public topic with default subscription "opt_out".
RESEND_NEWSLETTER_TOPIC_ID=...

# Generate with: openssl rand -hex 32
NEWSLETTER_TOKEN_SECRET=...

NEWSLETTER_FROM="Absendername <absender@example.com>"
# Antwortadresse der Newsletter-Mails (optional)
NEWSLETTER_REPLY_TO=
CONTACT_FROM="Absendername <absender@example.com>"
# Empfänger des Kontaktformulars (Pflicht, kein Standard im Code)
CONTACT_TO=empfaenger@example.com
# Optional outside Vercel. Vercel deployments derive their own URL automatically.
SITE_URL=https://benkohler.de
